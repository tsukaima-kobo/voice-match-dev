{
  "manifest_version": 3,
  "name": "voice-twin 収集",
  "version": "0.1.0",
  "description": "運営が再生している配信の声を、その場で数字にします。音は保存も送信もしません。voice-twin の運営用（ストアには出しません）。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["capture.worklet.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
